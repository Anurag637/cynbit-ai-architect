# Revio 2.0 Environment Configuration Template
# Copy this file to .env and insert your real keys if desired.
# The system operates in 100% functional fallback mode without any API keys.

# Optional: LLM Providers for generative response drafting
# If omitted or left empty, Revio automatically falls back to deterministic, policy-grounded templates.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Brand and Resolution Policy Settings
BRAND_NAME=Cynbit Hospitality Group
SUPPORT_EMAIL=support@cynbit.in
ESCALATION_EMAIL=executive-care@cynbit.in
SUPPORT_PHONE=+91-89479-62667

# Deployment & Security
ENVIRONMENT=development
LOG_LEVEL=INFO
